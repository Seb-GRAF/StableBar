{
  "branches": ["main"],
  "plugins": [
    "./.github/scripts/app-release.mjs",
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogTitle": "# Changelog" }],
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "echo ${nextRelease.version} > .next-version",
        "prepareCmd": "./scripts/set-version.sh ${nextRelease.version} $GITHUB_RUN_NUMBER && ./scripts/set-site-version.sh ${nextRelease.version} && STABLEBAR_RELEASE_BUILD=1 ./scripts/package.sh"
      }
    ],
    ["@semantic-release/git", { "assets": ["CHANGELOG.md", "Resources/Info.plist", "docs/images/*.webp", "site/index.html"] }],
    ["@semantic-release/github", { "assets": [{ "path": "dist/StableBar.dmg" }] }]
  ]
}
