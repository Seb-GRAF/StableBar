{
  "tokens": {
    "surface": { "light": "#ffffffee", "dark": "#141414ee" },
    "surfaceRaised": { "light": "#ebebeb", "dark": "#2b2b2b" },
    "text": { "light": "#111111", "dark": "#f2f2f2" },
    "textMuted": { "light": "#5c5c5c", "dark": "#a3a3a3" },
    "accent": { "light": "#111111", "dark": "#f2f2f2" },
    "track": { "light": "#11111126", "dark": "#f2f2f226" },
    "hairline": { "light": "#11111133", "dark": "#f2f2f233" },
    "warning": { "light": "#9a5800", "dark": "#ffb340" },
    "critical": { "light": "#c4001a", "dark": "#ff6b6b" }
  },
  "defaults": {
    "foreground": "@token.text",
    "background": "@token.surface",
    "hoverBackground": "@token.surfaceRaised",
    "borderColor": "@token.hairline",
    "accent": "@token.accent",
    "accentText": { "light": "#ffffff", "dark": "#111111" },
    "cornerRadius": 4,
    "shadowColor": "#00000000"
  }
}
