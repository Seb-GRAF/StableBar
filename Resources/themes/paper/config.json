{
  "tokens": {
    "surface": { "light": "#f6f1e7ee", "dark": "#2a2520ee" },
    "surfaceRaised": { "light": "#fffaf0", "dark": "#3a332c" },
    "text": { "light": "#2b2622", "dark": "#efe7da" },
    "textMuted": { "light": "#6f665c", "dark": "#ada291" },
    "accent": { "light": "#b4532a", "dark": "#e8875a" },
    "track": { "light": "#2b262226", "dark": "#efe7da26" },
    "hairline": { "light": "#2b26221f", "dark": "#efe7da1f" },
    "warning": { "light": "#9a5800", "dark": "#f2b45e" },
    "critical": { "light": "#b42318", "dark": "#f2786b" }
  },
  "defaults": {
    "foreground": "@token.text",
    "background": "@token.surface",
    "hoverBackground": "@token.surfaceRaised",
    "borderColor": "@token.hairline",
    "accent": "@token.accent",
    "cornerRadius": 6
  }
}
