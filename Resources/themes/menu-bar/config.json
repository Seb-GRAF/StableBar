{
  "tokens": {
    "surface": { "light": "#f8f8faed", "dark": "#242629ee" },
    "track": { "light": "#1d1d1f26", "dark": "#f5f5f726" },
    "hairline": { "light": "#1d1d1f1f", "dark": "#ffffff1f" }
  },
  "bar": {
    "style": {
      "background": "@token.surface",
      "borderColor": "@token.hairline",
      "borderWidth": 1
    }
  },
  "defaults": {
    "background": null,
    "hoverBackground": "@token.track",
    "borderColor": null,
    "shadowColor": null,
    "cornerRadius": 8,
    "fontSize": 13,
    "fontWeight": "regular"
  },
  "popupDefaults": {
    "background": "@token.surface",
    "borderColor": "@token.hairline",
    "shadowColor": { "light": "#00000014", "dark": "#00000040" }
  }
}
