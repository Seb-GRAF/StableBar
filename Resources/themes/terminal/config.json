{
  "tokens": {
    "surface": { "light": "#f9f5d7", "dark": "#1d2021" },
    "surfaceRaised": { "light": "#ebdbb2", "dark": "#3c3836" },
    "text": { "light": "#3c3836", "dark": "#ebdbb2" },
    "textMuted": { "light": "#7c6f64", "dark": "#a89984" },
    "accent": { "light": "#b57614", "dark": "#fabd2f" },
    "track": { "light": "#d5c4a1", "dark": "#504945" },
    "hairline": { "light": "#bdae93", "dark": "#504945" },
    "warning": { "light": "#af3a03", "dark": "#fe8019" },
    "critical": { "light": "#9d0006", "dark": "#fb4934" }
  },
  "bar": {
    "style": {
      "background": "@token.surface",
      "borderColor": "@token.hairline",
      "borderWidth": 1
    }
  },
  "defaults": {
    "borderColor": "@token.hairline",
    "shadowColor": null,
    "accentText": "@token.surface",
    "cornerRadius": 0,
    "fontName": "Menlo",
    "fontSize": 11,
    "fontWeight": "regular"
  }
}
