{
  "tokens": {
    "surface": { "light": "#eff1f5f2", "dark": "#1e1e2ef2" },
    "surfaceRaised": { "light": "#ccd0da", "dark": "#313244" },
    "text": { "light": "#4c4f69", "dark": "#cdd6f4" },
    "textMuted": { "light": "#6c6f85", "dark": "#a6adc8" },
    "accent": { "light": "#8839ef", "dark": "#cba6f7" },
    "track": { "light": "#bcc0cc", "dark": "#45475a" },
    "hairline": { "light": "#4c4f691f", "dark": "#cdd6f41f" },
    "warning": { "light": "#fe640b", "dark": "#fab387" },
    "critical": { "light": "#d20f39", "dark": "#f38ba8" }
  },
  "bar": {
    "margin": 6,
    "style": {
      "background": "@token.surface",
      "cornerRadius": 12
    }
  },
  "defaults": {
    "background": null,
    "hoverBackground": "@token.surfaceRaised",
    "borderColor": null,
    "shadowColor": null,
    "accentText": { "light": "#eff1f5", "dark": "#1e1e2e" },
    "cornerRadius": 10,
    "paddingVertical": 3
  },
  "popupDefaults": {
    "background": "@token.surface",
    "borderColor": "@token.hairline",
    "shadowColor": { "light": "#00000014", "dark": "#00000040" }
  }
}
