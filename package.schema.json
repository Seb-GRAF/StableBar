{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StableBar package",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "entry"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "kind": { "enum": ["theme", "widgets"] },
    "entry": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "repository": { "type": "string", "pattern": "^https://" },
    "screenshot": { "type": "string" },
    "minimumVersion": { "type": "string" },
    "requires": { "type": "array", "items": { "type": "string" } },
    "permissions": {
      "type": "array",
      "items": { "enum": ["calendars", "automation", "accessibility", "bluetooth", "location"] }
    },
    "hosts": { "type": "array", "items": { "type": "string" } },
    "settings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/setting" }
    }
  },
  "definitions": {
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "description": "What the setting is set to.", "type": "string" },
        "title": { "description": "What Settings shows in place of the value.", "type": "string" },
        "image": {
          "description": "Path inside the package to a PNG or JPEG of what the choice does. When every choice has one, Settings shows the choices as images.",
          "type": "string"
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "number", "bool", "secret"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "choices": {
          "description": "The values a string setting accepts: plain strings, or objects with a title and an image. Objects need StableBar 0.14.0 or later, so set minimumVersion.",
          "type": "array",
          "minItems": 1,
          "items": { "anyOf": [{ "type": "string" }, { "$ref": "#/definitions/choice" }] }
        },
        "default": {}
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "secret" } } },
          "then": { "not": { "anyOf": [{ "required": ["default"] }, { "required": ["choices"] }] } },
          "else": { "required": ["default"] }
        },
        {
          "if": { "properties": { "type": { "const": "string" } } },
          "then": { "properties": { "default": { "type": "string" } } },
          "else": { "not": { "required": ["choices"] } }
        },
        {
          "if": { "properties": { "type": { "const": "number" } } },
          "then": { "properties": { "default": { "type": "number" } } }
        },
        {
          "if": { "properties": { "type": { "const": "bool" } } },
          "then": { "properties": { "default": { "type": "boolean" } } }
        }
      ]
    }
  }
}
