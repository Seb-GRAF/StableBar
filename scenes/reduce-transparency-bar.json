{
  "$schema": "../scene.schema.json",
  "configuration": {
    "workspaceSource": "aerospace",
    "widgets": [
      { "id": "workspaces", "type": "workspaces", "position": "left" },
      { "id": "app", "type": "appMenu", "position": "left" },
      { "id": "battery", "type": "battery", "position": "right" },
      { "id": "date", "type": "clock", "format": "EEE d MMM", "position": "right" },
      { "id": "time", "type": "clock", "format": "HH:mm", "position": "right" }
    ]
  },
  "workspaces": [
    { "workspace": "1", "workspace-is-focused": false, "workspace-is-visible": false, "monitor-appkit-nsscreen-screens-id": 1 },
    { "workspace": "2", "workspace-is-focused": true, "workspace-is-visible": true, "monitor-appkit-nsscreen-screens-id": 1 }
  ],
  "windows": [
    { "window-id": 1, "window-title": "Safari", "workspace": "1", "app-name": "Safari", "app-bundle-id": "com.apple.Safari" },
    { "window-id": 2, "window-title": "Terminal", "workspace": "2", "app-name": "Terminal", "app-bundle-id": "com.apple.Terminal" },
    { "window-id": 3, "window-title": "Music", "workspace": "2", "app-name": "Music", "app-bundle-id": "com.apple.Music" }
  ],
  "accessibilityDisplay": ["reduceTransparency"],
  "draw": "bar",
  "width": 900
}
