{
  "$schema": "../scene.schema.json",
  "configuration": {
    "bar": { "height": 40, "belowMenuBar": true, "inset": 12, "spacing": 8 },
    "widgets": [
      { "id": "apple", "type": "appleMenu", "position": "left" },
      { "id": "app-menu", "type": "appMenu", "position": "left" },
      { "id": "sound", "type": "audio", "position": "right" },
      { "id": "clock", "type": "clock", "position": "right", "format": "EEE d MMM  HH:mm" },
      { "id": "menu-bar-items", "type": "menuBarItems", "position": "right" }
    ]
  },
  "outputs": {
    "audio": {
      "text": "45%",
      "icon": "speaker.wave.2.fill",
      "value": 0.45,
      "fields": { "volumeAvailable": "true", "muted": "false" },
      "values": { "volume": 0.45 }
    }
  },
  "draw": "settings",
  "section": "bar",
  "tab": "placement"
}
