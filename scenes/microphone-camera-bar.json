{
  "$schema": "../scene.schema.json",
  "configuration": {
    "widgets": [
      {
        "id": "microphone", "type": "microphone", "position": "right",
        "rules": [{ "when": { "field": "inUse", "equals": "true" }, "state": "active" }],
        "style": { "states": { "active": { "foreground": "#ff9f0a" } } }
      },
      {
        "id": "camera", "type": "camera", "position": "right",
        "rules": [{ "when": { "field": "inUse", "equals": "true" }, "state": "active" }]
      },
      { "id": "time", "type": "clock", "format": "HH:mm", "position": "right" }
    ]
  },
  "outputs": {
    "microphone": {
      "text": "70%",
      "icon": "mic.fill",
      "value": 0.7,
      "fields": { "device": "MacBook Pro Microphone", "volumeAvailable": "true", "muted": "false", "inUse": "true" },
      "values": { "volume": 0.7 }
    },
    "camera": {
      "text": "Off",
      "icon": "video",
      "fields": { "inUse": "false" }
    }
  },
  "draw": "bar",
  "width": 600
}
