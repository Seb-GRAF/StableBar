{
  "$schema": "../scene.schema.json",
  "configuration": {
    "widgets": [
      {
        "id": "sound",
        "type": "script",
        "command": "true",
        "position": "right",
        "popup": {
          "style": { "width": 300, "paddingHorizontal": 16, "paddingVertical": 16, "spacing": 12 },
          "layout": {
            "type": "column",
            "children": [
              { "type": "text", "text": "Sound", "style": { "fontWeight": "bold", "fontSize": 15 } },
              {
                "type": "slider", "title": "Volume", "source": "volume", "onChange": "true",
                "filled": true, "icon": "speaker.wave.2.fill",
                "style": { "height": 40, "cornerRadius": 20, "iconSize": 16, "background": "@token.surfaceRaised" }
              },
              {
                "type": "slider", "title": "Muted", "source": "muted", "onChange": "true",
                "filled": true, "icon": "speaker.slash.fill",
                "style": { "height": 40, "cornerRadius": 20, "iconSize": 16, "background": "@token.surfaceRaised" }
              },
              { "type": "text", "text": "Without a background or icon" },
              {
                "type": "slider", "title": "Brightness", "source": "brightness", "min": 0, "max": 100, "step": 5, "onChange": "true",
                "filled": true, "style": { "height": 24, "cornerRadius": 6 }
              }
            ]
          }
        }
      }
    ]
  },
  "outputs": {
    "sound": {
      "text": "Sound",
      "icon": "speaker.wave.2",
      "values": { "volume": 0.62, "muted": 0, "brightness": 35 }
    }
  },
  "draw": "popup",
  "widget": "sound",
  "height": 280
}
