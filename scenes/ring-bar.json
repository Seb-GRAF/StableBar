{
  "$schema": "../scene.schema.json",
  "configuration": {
    "widgets": [
      {
        "id": "battery-ring",
        "type": "battery",
        "position": "right",
        "layout": {
          "type": "ring",
          "source": "percent",
          "lineWidth": 2,
          "style": { "iconSize": 18, "accent": "#30d158", "background": "#8e8e9340" },
          "children": [{ "type": "symbol", "name": "bolt.fill", "style": { "iconSize": 9 } }]
        }
      },
      {
        "id": "cpu-ring",
        "type": "system",
        "position": "right",
        "layout": {
          "type": "row",
          "style": { "spacing": 6 },
          "children": [
            { "type": "ring", "source": "cpu", "style": { "iconSize": 14, "background": "#8e8e9340" } },
            { "type": "field", "field": "text" }
          ]
        }
      },
      {
        "id": "volume-ring",
        "type": "script",
        "command": "true",
        "position": "right",
        "layout": {
          "type": "ring",
          "source": "volume",
          "gap": 90,
          "lineWidth": 1.5,
          "style": { "iconSize": 20, "accent": "#0a84ff", "background": "#8e8e9340" },
          "children": [
            { "type": "symbol", "name": "speaker.wave.2.fill", "style": { "iconSize": 8 } },
            {
              "type": "progress",
              "source": "volume",
              "height": 2,
              "segments": 4,
              "style": { "width": 11, "spacing": 1, "cornerRadius": 1, "offsetY": 8.5 }
            }
          ]
        }
      },
      { "id": "time", "type": "clock", "format": "HH:mm", "position": "right" }
    ]
  },
  "outputs": {
    "battery": {
      "text": "62%",
      "values": { "percent": 0.62 },
      "fields": { "percent": "62", "state": "charging" }
    },
    "volume-ring": {
      "text": "62%",
      "values": { "volume": 0.62 }
    },
    "system": {
      "text": "38%",
      "icon": "cpu",
      "value": 0.38,
      "fields": { "cpu": "38", "memory": "61" },
      "values": { "cpu": 0.38, "memory": 0.61 }
    }
  },
  "draw": "bar",
  "width": 500
}
