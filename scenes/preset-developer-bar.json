{
  "$schema": "../scene.schema.json",
  "configuration": {
    "theme": {
      "id": "clear"
    },
    "workspaceSource": "aerospace",
    "widgets": [
      {
        "id": "apple",
        "type": "appleMenu",
        "position": "left"
      },
      {
        "id": "workspaces",
        "type": "workspaces",
        "position": "left"
      },
      {
        "id": "app-menu",
        "type": "appMenu",
        "position": "left",
        "expandOnHover": true
      },
      {
        "id": "system-monitor",
        "type": "system",
        "position": "right",
        "details": true,
        "layout": {
          "type": "row",
          "style": {
            "spacing": 14
          },
          "children": [
            {
              "type": "row",
              "style": {
                "spacing": 6
              },
              "children": [
                {
                  "type": "text",
                  "text": "CPU",
                  "role": "key",
                  "style": {
                    "fontWeight": "medium"
                  }
                },
                {
                  "type": "field",
                  "field": "text",
                  "alignment": "trailing",
                  "style": {
                    "minWidth": 37
                  }
                },
                {
                  "type": "progress",
                  "source": "cpu",
                  "height": 4,
                  "role": "meter",
                  "style": {
                    "width": 32
                  }
                }
              ]
            },
            {
              "type": "row",
              "style": {
                "spacing": 6
              },
              "children": [
                {
                  "type": "text",
                  "text": "MEM",
                  "role": "key",
                  "style": {
                    "fontWeight": "medium"
                  }
                },
                {
                  "type": "row",
                  "alignment": "trailing",
                  "style": {
                    "spacing": 0,
                    "minWidth": 37
                  },
                  "children": [
                    {
                      "type": "field",
                      "field": "memory"
                    },
                    {
                      "type": "text",
                      "text": "%"
                    }
                  ]
                },
                {
                  "type": "progress",
                  "source": "memory",
                  "height": 4,
                  "role": "meter",
                  "style": {
                    "width": 32
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": "battery",
        "type": "battery",
        "position": "right",
        "details": true
      },
      {
        "id": "date",
        "type": "clock",
        "position": "right",
        "format": "EEE d MMM",
        "role": "secondary",
        "details": true
      },
      {
        "id": "clock",
        "type": "clock",
        "position": "right",
        "format": "HH:mm",
        "role": "time",
        "details": true
      },
      {
        "id": "menu-bar-items",
        "type": "menuBarItems",
        "position": "right"
      }
    ]
  },
  "outputs": {
    "battery": {
      "text": "82%",
      "icon": "battery.75percent",
      "values": {
        "percent": 0.82
      },
      "fields": {
        "percent": "82",
        "state": "battery",
        "present": "true",
        "health": "normal",
        "timeRemaining": "285"
      }
    },
    "system": {
      "text": "18%",
      "icon": "cpu",
      "value": 0.18,
      "fields": {
        "cpu": "18",
        "memory": "54",
        "pressure": "normal",
        "thermal": "nominal"
      },
      "values": {
        "cpu": 0.18,
        "memory": 0.54
      }
    }
  },
  "workspaces": [
    {
      "workspace": "1",
      "workspace-is-focused": false,
      "workspace-is-visible": false,
      "monitor-appkit-nsscreen-screens-id": 1
    },
    {
      "workspace": "2",
      "workspace-is-focused": true,
      "workspace-is-visible": true,
      "monitor-appkit-nsscreen-screens-id": 1
    },
    {
      "workspace": "3",
      "workspace-is-focused": false,
      "workspace-is-visible": false,
      "monitor-appkit-nsscreen-screens-id": 1
    },
    {
      "workspace": "4",
      "workspace-is-focused": false,
      "workspace-is-visible": false,
      "monitor-appkit-nsscreen-screens-id": 1
    },
    {
      "workspace": "5",
      "workspace-is-focused": false,
      "workspace-is-visible": false,
      "monitor-appkit-nsscreen-screens-id": 1
    }
  ],
  "windows": [
    {
      "workspace": "1",
      "app-name": "Arc",
      "app-bundle-id": "company.thebrowser.Browser",
      "window-id": 1,
      "window-title": "Pull requests"
    },
    {
      "workspace": "2",
      "app-name": "Ghostty",
      "app-bundle-id": "com.mitchellh.ghostty",
      "window-id": 2,
      "window-title": "~/code/api"
    },
    {
      "workspace": "2",
      "app-name": "Cursor",
      "app-bundle-id": "com.todesktop.230313mzl4w4u92",
      "window-id": 3,
      "window-title": "server.ts"
    },
    {
      "workspace": "3",
      "app-name": "Slack",
      "app-bundle-id": "com.tinyspeck.slackmacgap",
      "window-id": 4,
      "window-title": "#platform"
    },
    {
      "workspace": "3",
      "app-name": "Mail",
      "app-bundle-id": "com.apple.mail",
      "window-id": 5,
      "window-title": "Inbox"
    },
    {
      "workspace": "4",
      "app-name": "Figma",
      "app-bundle-id": "com.figma.Desktop",
      "window-id": 6,
      "window-title": "Checkout flow"
    },
    {
      "workspace": "5",
      "app-name": "Spotify",
      "app-bundle-id": "com.spotify.client",
      "window-id": 7,
      "window-title": "Spotify"
    }
  ],
  "focusedWindow": 2,
  "activeApp": "com.mitchellh.ghostty",
  "draw": "bar"
}
