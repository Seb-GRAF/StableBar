{
  "$schema": "../scene.schema.json",
  "configuration": {
    "widgets": [
      {
        "id": "disk",
        "type": "disk",
        "position": "right",
        "details": true,
        "style": {
          "states": {
            "warning": { "foreground": "@token.warning", "accent": "@token.warning" },
            "critical": { "foreground": "@token.critical", "accent": "@token.critical" }
          }
        }
      },
      {
        "id": "disk-meter",
        "type": "disk",
        "position": "right",
        "details": true,
        "style": {
          "states": {
            "warning": { "foreground": "@token.warning", "accent": "@token.warning" },
            "critical": { "foreground": "@token.critical", "accent": "@token.critical" }
          }
        },
        "layout": {
          "type": "row",
          "children": [
            {
              "type": "progress",
              "source": "disk",
              "height": 4,
              "style": {
                "width": 40
              }
            },
            {
              "type": "symbol",
              "source": "icon"
            },
            {
              "type": "field",
              "field": "text"
            }
          ]
        }
      }
    ]
  },
  "outputs": {
    "disk": {
      "text": "86%",
      "icon": "internaldrive",
      "tooltip": "67 GB free on Macintosh HD",
      "state": "warning",
      "fields": {
        "format": "APFS",
        "free": "67 GB",
        "percent": "86",
        "total": "494 GB",
        "used": "428 GB",
        "volume": "Macintosh HD"
      },
      "values": {
        "disk": 0.865,
        "free": 66800000000,
        "total": 494380000000,
        "used": 427580000000
      }
    }
  },
  "draw": "bar",
  "width": 600
}
