{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StableBar configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "roles": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "time": {
              "anyOf": [
                {
                  "$ref": "#/definitions/style"
                },
                {
                  "$ref": "#/definitions/reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "primary": {
              "anyOf": [
                {
                  "$ref": "#/definitions/style"
                },
                {
                  "$ref": "#/definitions/reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "secondary": {
              "anyOf": [
                {
                  "$ref": "#/definitions/style"
                },
                {
                  "$ref": "#/definitions/reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "key": {
              "anyOf": [
                {
                  "$ref": "#/definitions/style"
                },
                {
                  "$ref": "#/definitions/reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "value": {
              "anyOf": [
                {
                  "$ref": "#/definitions/style"
                },
                {
                  "$ref": "#/definitions/reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "heading": {
              "anyOf": [
                {
                  "$ref": "#/definitions/style"
                },
                {
                  "$ref": "#/definitions/reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "button": {
              "anyOf": [
                {
                  "$ref": "#/definitions/style"
                },
                {
                  "$ref": "#/definitions/reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "meter": {
              "anyOf": [
                {
                  "$ref": "#/definitions/style"
                },
                {
                  "$ref": "#/definitions/reference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "separator": {
              "anyOf": [
                {
                  "$ref": "#/definitions/style"
                },
                {
                  "$ref": "#/definitions/reference"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "$ref": "#/definitions/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspaceDefaults": {
      "anyOf": [
        {
          "$ref": "#/definitions/workspaceDefaults"
        },
        {
          "$ref": "#/definitions/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "$schema": {
      "type": "string"
    },
    "workspaceSource": {
      "type": "string",
      "enum": ["aerospace", "yabai"]
    },
    "modeAliases": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "pattern": "\\S"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              {
                "$ref": "#/definitions/reference"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "User mapping of AeroSpace mode names to semantic mode.<alias> states. Themes cannot set this mapping."
        },
        {
          "$ref": "#/definitions/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "includes": {
      "$ref": "#/definitions/strings",
      "description": "Files to compose before this one, relative to this file."
    },
    "bar": {
      "$ref": "#/definitions/bar"
    },
    "defaults": {
      "anyOf": [
        {
          "$ref": "#/definitions/style"
        },
        {
          "$ref": "#/definitions/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "popupDefaults": {
      "anyOf": [
        {
          "$ref": "#/definitions/style"
        },
        {
          "$ref": "#/definitions/reference"
        },
        {
          "type": "null"
        }
      ],
      "description": "Styles every popup inherits. A popup's own style and its widget's style win; defaults fill the rest."
    },
    "widgets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/widget"
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/widget"
      }
    },
    "widgetOverrides": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/widget"
      },
      "description": "Properties merged into widgets by ID."
    },
    "widgetOrder": {
      "$ref": "#/definitions/strings",
      "description": "Widget IDs to place first."
    },
    "popups": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/popup"
      }
    },
    "environment": {
      "$ref": "#/definitions/environment"
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/provider"
      }
    },
    "groups": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/group"
      }
    },
    "tokens": {
      "type": "object",
      "description": "Values referenced as \"@token.name\"."
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/profile"
      }
    },
    "profile": {
      "$ref": "#/definitions/string",
      "description": "Name of the only profile to apply, or null for automatic matching."
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/packageSelection"
      }
    },
    "theme": {
      "$ref": "#/definitions/packageSelection",
      "description": "Theme applied after widget packages and before includes. Without version, a theme that ships with StableBar; with version, an installed theme package."
    }
  },
  "definitions": {
    "workspaceDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "indicator": {
          "anyOf": [
            {
              "enum": [
                "background",
                "underline",
                "none"
              ]
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "indicatorStyle": {
          "anyOf": [
            {
              "$ref": "#/definitions/style"
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/definitions/style"
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "appStyle": {
          "anyOf": [
            {
              "$ref": "#/definitions/style"
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "reference": {
      "type": "string",
      "pattern": "^@(token|setting)\\."
    },
    "number": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/definitions/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "string": {
      "type": [
        "string",
        "null"
      ]
    },
    "boolean": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/definitions/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
    },
    "color": {
      "anyOf": [
        {
          "$ref": "#/definitions/hexColor"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "light",
            "dark"
          ],
          "properties": {
            "light": {
              "anyOf": [
                {
                  "$ref": "#/definitions/hexColor"
                },
                {
                  "$ref": "#/definitions/reference"
                }
              ]
            },
            "dark": {
              "anyOf": [
                {
                  "$ref": "#/definitions/hexColor"
                },
                {
                  "$ref": "#/definitions/reference"
                }
              ]
            }
          }
        },
        {
          "$ref": "#/definitions/reference"
        },
        {
          "type": "null"
        }
      ],
      "description": "#RRGGBB or #RRGGBBAA, or {\"light\": …, \"dark\": …} for a color that follows the light or dark appearance."
    },
    "strings": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "environment": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "position": {
      "anyOf": [
        {
          "enum": [
            "left",
            "notchLeft",
            "center",
            "notchRight",
            "right"
          ]
        },
        {
          "$ref": "#/definitions/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "alignment": {
      "anyOf": [
        {
          "enum": [
            "leading",
            "center",
            "trailing"
          ]
        },
        {
          "$ref": "#/definitions/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "display": {
      "anyOf": [
        {
          "$ref": "#/definitions/displayKind"
        },
        {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        {
          "type": "array",
          "description": "Screens matching any of these kinds.",
          "items": {
            "$ref": "#/definitions/displayKind"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "displayKind": {
      "enum": [
        "all",
        "active",
        "main",
        "builtIn",
        "external",
        "monitor",
        "vertical",
        "notched",
        "unnotched"
      ]
    },
    "glass": {
      "type": "object",
      "additionalProperties": false,
      "description": "Experimental. Draws the widget, popup and bar backgrounds as native Liquid Glass on macOS 26 and later, tinted with their colors.",
      "properties": {
        "enabled": {
          "$ref": "#/definitions/boolean",
          "description": "Turns Liquid Glass on. Off by default."
        },
        "transparency": {
          "anyOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "$ref": "#/definitions/reference" },
            { "type": "null" }
          ],
          "description": "How much glass shows through the background colors: 0 keeps the colors, 1 is pure glass. 0.3 by default."
        },
        "widgets": {
          "$ref": "#/definitions/boolean",
          "description": "Glass for widgets that have a background. On by default."
        },
        "popups": {
          "$ref": "#/definitions/boolean",
          "description": "Glass for popups that have a background. On by default."
        },
        "bar": {
          "$ref": "#/definitions/boolean",
          "description": "Glass for the bar when it has a background. On by default."
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "foreground": {
          "$ref": "#/definitions/color"
        },
        "background": {
          "$ref": "#/definitions/color"
        },
        "hoverBackground": {
          "$ref": "#/definitions/color"
        },
        "borderColor": {
          "$ref": "#/definitions/color"
        },
        "accent": {
          "$ref": "#/definitions/color"
        },
        "accentText": {
          "$ref": "#/definitions/color"
        },
        "shadowColor": {
          "$ref": "#/definitions/color"
        },
        "hoverForeground": {
          "$ref": "#/definitions/color"
        },
        "placement": {
          "anyOf": [
            { "enum": ["cell", "belowBar"] },
            { "$ref": "#/definitions/reference" },
            { "type": "null" }
          ],
          "description": "Workspace indicatorStyle only: cell preserves cell-relative drawing; belowBar starts at the visible bar bottom plus offsetY."
        },
        "borderEdges": {
          "anyOf": [
            { "enum": ["bottom", "all"] },
            { "$ref": "#/definitions/reference" },
            { "type": "null" }
          ],
          "description": "Only bar.style and script barStyle consume this property. Bottom preserves the default; all draws an inset outline."
        },
        "borderWidth": {
          "$ref": "#/definitions/number"
        },
        "cornerRadius": {
          "$ref": "#/definitions/number"
        },
        "fontSize": {
          "$ref": "#/definitions/number"
        },
        "iconSize": {
          "$ref": "#/definitions/number"
        },
        "paddingHorizontal": {
          "$ref": "#/definitions/number"
        },
        "paddingVertical": {
          "$ref": "#/definitions/number"
        },
        "spacing": {
          "$ref": "#/definitions/number"
        },
        "width": {
          "$ref": "#/definitions/number"
        },
        "minWidth": {
          "$ref": "#/definitions/number"
        },
        "maxWidth": {
          "$ref": "#/definitions/number"
        },
        "shadowRadius": {
          "$ref": "#/definitions/number"
        },
        "height": {
          "$ref": "#/definitions/number"
        },
        "paddingLeading": {
          "$ref": "#/definitions/number"
        },
        "paddingTrailing": {
          "$ref": "#/definitions/number"
        },
        "paddingTop": {
          "$ref": "#/definitions/number"
        },
        "paddingBottom": {
          "$ref": "#/definitions/number"
        },
        "offsetX": {
          "$ref": "#/definitions/number"
        },
        "offsetY": {
          "$ref": "#/definitions/number"
        },
        "opacity": {
          "$ref": "#/definitions/number"
        },
        "fontName": {
          "$ref": "#/definitions/string",
          "description": "\"system\" or an installed font name."
        },
        "fontWeight": {
          "anyOf": [
            {
              "enum": [
                "ultralight",
                "thin",
                "light",
                "regular",
                "medium",
                "semibold",
                "bold"
              ]
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "states": {
          "$ref": "#/definitions/states"
        }
      },
      "description": "Widget style. Unset values inherit from defaults."
    },
    "states": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/definitions/style"
              },
              {
                "$ref": "#/definitions/reference"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        {
          "$ref": "#/definitions/reference"
        },
        {
          "type": "null"
        }
      ],
      "description": "Styles applied after base layers: data state, workspace state, mode, mode.<alias>, hover, then open. Groups do not consume states."
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "curve": {
          "anyOf": [
            {
              "enum": [
                "linear",
                "easeIn",
                "easeOut",
                "easeInOut",
                "smooth",
                "spring"
              ]
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration": {
          "$ref": "#/definitions/number"
        }
      }
    },
    "transition": {
      "anyOf": [
        {
          "enum": [
            "none",
            "fade",
            "roll",
            "numeric"
          ]
        },
        {
          "$ref": "#/definitions/reference"
        },
        {
          "type": "null"
        }
      ],
      "description": "How changed text and symbols appear: none, fade, roll or numeric."
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rightClick": {
          "$ref": "#/definitions/string"
        },
        "middleClick": {
          "$ref": "#/definitions/string"
        },
        "scrollUp": {
          "$ref": "#/definitions/string"
        },
        "scrollDown": {
          "$ref": "#/definitions/string"
        },
        "mouseEntered": {
          "$ref": "#/definitions/string"
        },
        "mouseExited": {
          "$ref": "#/definitions/string"
        }
      }
    },
    "menuItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/definitions/string"
        },
        "detail": {
          "$ref": "#/definitions/string"
        },
        "onClick": {
          "$ref": "#/definitions/string"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/definitions/string"
        },
        "value": {
          "$ref": "#/definitions/string"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {"anyOf": [{"enum": ["time", "primary", "secondary", "key", "value", "heading", "button", "meter", "separator"]}, {"$ref": "#/definitions/reference"}, {"type": "null"}]},
        "type": {
          "anyOf": [
            {
              "enum": [
                "row",
                "column",
                "text",
                "field",
                "graph",
                "list",
                "button",
                "slider",
                "toggle",
                "segmented",
                "search",
                "menu",
                "divider",
                "image",
                "symbol",
                "progress",
                "equalizer"
              ]
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/definitions/style"
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "alignment": {
          "$ref": "#/definitions/alignment"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/block"
          }
        },
        "text": {
          "$ref": "#/definitions/string"
        },
        "field": {
          "$ref": "#/definitions/string"
        },
        "height": {
          "$ref": "#/definitions/number"
        },
        "source": {
          "$ref": "#/definitions/string"
        },
        "row": {
          "$ref": "#/definitions/block"
        },
        "title": {
          "$ref": "#/definitions/string"
        },
        "onClick": {
          "$ref": "#/definitions/string"
        },
        "open": {
          "$ref": "#/definitions/string",
          "description": "An http, https, mailto or x-apple.systempreferences URL, or an application bundle identifier."
        },
        "path": {
          "$ref": "#/definitions/string"
        },
        "fit": {
          "anyOf": [
            {
              "enum": [
                "fit",
                "fill"
              ]
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "$ref": "#/definitions/string"
        },
        "animation": {
          "$ref": "#/definitions/animation"
        },
        "styleSource": {
          "$ref": "#/definitions/string"
        },
        "styleField": {
          "$ref": "#/definitions/string"
        },
        "onClickField": {
          "$ref": "#/definitions/string"
        },
        "openField": {
          "$ref": "#/definitions/string"
        },
        "lineWidth": {
          "$ref": "#/definitions/number"
        },
        "hideWhenEmpty": {
          "$ref": "#/definitions/string"
        },
        "scrollSpeed": {
          "$ref": "#/definitions/number"
        },
        "transition": {
          "$ref": "#/definitions/transition",
          "description": "For text, field and symbol blocks; defaults to the widget's."
        },
        "min": {
          "$ref": "#/definitions/number"
        },
        "max": {
          "$ref": "#/definitions/number"
        },
        "step": {
          "$ref": "#/definitions/number"
        },
        "onChange": {
          "$ref": "#/definitions/string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/option"
          }
        },
        "searchFields": {
          "$ref": "#/definitions/strings"
        }
      },
      "description": "A layout block for widget layouts, overlays and popups."
    },
    "popup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "height": {
          "$ref": "#/definitions/number"
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/definitions/style"
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "layout": {
          "$ref": "#/definitions/block"
        },
        "alignment": {
          "$ref": "#/definitions/alignment"
        },
        "offset": {
          "$ref": "#/definitions/number"
        },
        "dismissOnAction": {
          "$ref": "#/definitions/boolean"
        },
        "openOnHover": {
          "$ref": "#/definitions/boolean"
        },
        "dismissOnControl": {
          "$ref": "#/definitions/boolean"
        },
        "animation": {
          "$ref": "#/definitions/animation"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "indicator": {
          "anyOf": [
            {
              "enum": [
                "background",
                "underline",
                "none"
              ]
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "indicatorStyle": {
          "anyOf": [
            {
              "$ref": "#/definitions/style"
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/definitions/style"
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "focusedStyle": {
          "anyOf": [
            {
              "$ref": "#/definitions/style"
            },
            {
              "$ref": "#/definitions/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibleStyle": {
          "anyOf": [
            {
