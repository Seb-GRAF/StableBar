{
  "bar": {
    "height": 36,
    "offset": 32,
    "spacing": 6
  },
  "defaults": {
    "background": "#18212ded",
    "foreground": "#e4edf7",
    "accent": "#8bd5ca",
    "cornerRadius": 6,
    "fontSize": 12,
    "states": {
      "hover": { "background": "#29384b" },
      "warning": { "foreground": "#f5c26b" },
      "critical": {
        "foreground": "#18212d",
        "background": "#f28b82",
        "states": { "hover": { "background": "#f5a59e" } }
      },
      "active": { "foreground": "#8bd5ca" },
      "muted": { "opacity": 0.5 }
    }
  },
  "profiles": [
    {
      "name": "portable",
      "when": { "onBattery": true },
      "configuration": { "bar": { "spacing": 4 } }
    }
  ],
  "templates": {
    "metric": {
      "type": "script",
      "position": "right",
      "interval": 30,
      "timeout": 5,
      "style": {
        "fontWeight": "medium",
        "paddingHorizontal": 10
      }
    }
  }
}
